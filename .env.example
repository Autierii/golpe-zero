DOMINIO=localhost
# gere um valor aleatório, ex.: python -c "import secrets;print(secrets.token_urlsafe(32))"
METRICS_TOKEN=troque-por-um-valor-aleatorio
GRAFANA_ADMIN_PASSWORD=troque-por-uma-senha-forte
OLLAMA_MODEL=qwen2.5:3b
REGISTRY=ghcr.io/autierii
TAG=latest

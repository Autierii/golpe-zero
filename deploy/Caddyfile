# Caddy: única porta de entrada. HTTPS automático (Let's Encrypt) no domínio
# da Azure; em "localhost" usa certificado local.
{
	admin off
}

{$DOMINIO} {
	encode zstd gzip

	# prints grandes são recusados antes de chegar à API
	request_body {
		max_size 8MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# CSP estrita no app; o Swagger (/docs) carrega JS/CSS do jsDelivr
	@app not path /docs* /openapi.json /grafana*
	header @app Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	header /docs* Content-Security-Policy "default-src 'self'; img-src 'self' data: https://fastapi.tiangolo.com; style-src 'self' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; frame-ancestors 'none'"

	# Métricas: só com o token (scraper externo). Sem token = 404, nem revela que existem.
	# O teste fica DENTRO de cada handle: na ordem do Caddy, "handle" roda antes de
	# um "respond" solto, e o bloqueio nunca seria aplicado.
	@semToken not header Authorization "Bearer {$METRICS_TOKEN}"
	handle /metrics {
		respond @semToken 404
		reverse_proxy api:8000
	}
	handle /node-metrics {
		respond @semToken 404
		rewrite * /metrics
		reverse_proxy node-exporter:9100
	}

	handle /api/* {
		reverse_proxy api:8000 {
			transport http {
				read_timeout 180s
			}
		}
	}
	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}
	# Grafana: dashboard público só leitura; admin com senha (CSP própria do Grafana)
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy frontend:8080
	}

	log {
		output stdout
		# não registramos query string nem corpo: nada da mensagem do idoso vai para log
		format filter {
			wrap json
			request>uri regexp "\?.*$" ""
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>remote_ip ip_mask {
				ipv4 16
				ipv6 32
			}
			request>client_ip ip_mask {
				ipv4 16
				ipv6 32
			}
		}
	}
}
